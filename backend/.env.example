# Server Configuration
PORT=3001
NODE_ENV=development

# Active LLM Provider: "chatgpt", "gemini", or "mock"
LLM_PROVIDER=chatgpt

# ========================================================
# Google Gemini OAuth 2.0 Integration (Account-Based)
# Official Docs: https://ai.google.dev/gemini-api/docs/oauth
# Required Scope: https://www.googleapis.com/auth/generative-language
# ========================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/callback
GEMINI_MODEL=gemini-flash-lite-latest

# Optional Backend-Managed Gemini Key (Fallback when OAuth client is not yet registered)
GEMINI_API_KEY=

# ========================================================
# OpenAI "Sign in with ChatGPT" (SIWC) Integration
# Official Docs: https://developers.openai.com/siwc/quickstart
# Required PKCE: S256 Code Challenge
# ========================================================
OPENAI_CLIENT_ID=
OPENAI_CLIENT_SECRET=
OPENAI_REDIRECT_URI=http://localhost:3001/api/auth/callback
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions

# Optional Backend-Managed OpenAI Key (Fallback when SIWC developer client is not yet registered)
OPENAI_API_KEY=

# Graceful Mock Fallback (true/false)
FALLBACK_TO_MOCK=true
